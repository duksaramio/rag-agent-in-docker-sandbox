# S3 Compatible Object Storage (RustFS / MinIO)
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=gxp-docs
S3_REGION=us-east-1

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=gxp_documents

# Ollama Local Embeddings
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:8b

# Pydantic AI LLM (DeepSeek / OpenAI compatible API)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-flash

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langfuse
